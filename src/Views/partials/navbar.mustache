<!-- src/Views/partials/navbar.mustache -->
<header id="main-header" class="fixed top-0 w-full z-50 transition-all duration-300 bg-gradient-to-b from-black/80 to-transparent py-5">
  <nav class="max-w-7xl mx-auto flex items-center justify-between px-6">
    <a href="#" class="group flex items-center gap-3">
      <div class="relative w-10 h-10 group-hover:scale-110 transition-transform">
        <img src="images/logo.png" alt="FormulaZeta Logo" class="w-full h-full object-contain filter drop-shadow-[0_0_10px_rgba(255,0,0,0.3)]" />
      </div>
      <span class="text-xl font-display font-bold tracking-widest text-white group-hover:text-primary transition-colors">
        FormulaZeta
      </span>
    </a>

    <!-- Desktop Menu -->
    <ul class="hidden md:flex items-center space-x-8 text-sm font-medium tracking-wide">
      <li>
        <a href="#inicio" class="text-gray-300 hover:text-primary transition-colors duration-300 relative group py-2">
          Inicio
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"></span>
        </a>
      </li>
      <li>
        <a href="#sobre-mi" class="text-gray-300 hover:text-primary transition-colors duration-300 relative group py-2">
          Sobre Mí
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"></span>
        </a>
      </li>
      <li>
        <a href="#videos" class="text-gray-300 hover:text-primary transition-colors duration-300 relative group py-2">
          Videos
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"></span>
        </a>
      </li>
      <li>
        <a href="#calendario" class="text-gray-300 hover:text-primary transition-colors duration-300 relative group py-2">
          Calendario
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"></span>
        </a>
      </li>
      <li>
        <a href="#noticias" class="text-gray-300 hover:text-primary transition-colors duration-300 relative group py-2">
          Noticias
          <span class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-[1px] bg-primary transition-all duration-300 group-hover:w-full"></span>
        </a>
      </li>
    </ul>

    <!-- Action Button -->
    <div class="hidden md:block">
      <a href="#videos" class="flex items-center gap-1 bg-white/10 hover:bg-primary text-white px-5 py-2 rounded-full backdrop-blur-sm border border-white/10 hover:border-primary transition-all text-sm font-bold">
        Último Video <i data-lucide="chevron-right" class="w-4 h-4"></i>
      </a>
    </div>

    <!-- Mobile menu button -->
    <button id="mobile-menu-btn" class="md:hidden text-white hover:text-primary transition-colors" aria-label="Toggle menu">
      <i data-lucide="menu" id="menu-icon" class="w-7 h-7"></i>
      <i data-lucide="x" id="close-icon" class="w-7 h-7 hidden"></i>
    </button>
  </nav>

  <!-- Mobile Menu Dropdown -->
  <div id="mobile-menu-dropdown" class="md:hidden absolute w-full bg-black/95 backdrop-blur-xl border-b border-white/10 transition-all duration-300 overflow-hidden max-h-0 opacity-0">
    <ul class="flex flex-col px-6 py-4 space-y-4 text-center text-lg font-medium">
      <li><a href="#inicio" class="mobile-nav-link block text-gray-300 hover:text-primary transition-colors py-2">Inicio</a></li>
      <li><a href="#sobre-mi" class="mobile-nav-link block text-gray-300 hover:text-primary transition-colors py-2">Sobre Mí</a></li>
      <li><a href="#videos" class="mobile-nav-link block text-gray-300 hover:text-primary transition-colors py-2">Videos</a></li>
      <li><a href="#calendario" class="mobile-nav-link block text-gray-300 hover:text-primary transition-colors py-2">Calendario</a></li>
      <li><a href="#noticias" class="mobile-nav-link block text-gray-300 hover:text-primary transition-colors py-2">Noticias</a></li>
    </ul>
  </div>
</header>
