<!-- src/Views/partials/footer.mustache -->
<footer class="bg-darkBG border-t border-white/10 pt-16 pb-8">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-2">
        <div class="flex items-center gap-3 mb-6">
          <div class="relative w-12 h-12">
            <img src="images/logo.png" alt="FormulaZeta Logo" class="w-full h-full object-contain filter drop-shadow-[0_0_15px_rgba(255,0,0,0.4)]" />
          </div>
          <span class="text-2xl font-display font-bold tracking-widest text-white">
            FormulaZeta
          </span>
        </div>
        <p class="text-gray-400 text-sm max-w-sm mb-6">
          El ecosistema definitivo para los verdaderos apasionados del motor. Análisis, telemetría y noticias directas del paddock.
        </p>
        <div class="flex gap-4">
          <a href="{{social.youtube}}" target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-primary transition-all">
            <span class="text-xs font-bold">YT</span>
          </a>
          <a href="{{social.twitter}}" target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-primary transition-all">
            <span class="text-xs font-bold">TW</span>
          </a>
          <a href="{{social.instagram}}" target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-primary transition-all">
            <span class="text-xs font-bold">IG</span>
          </a>
          <a href="{{social.kick}}" target="_blank" rel="noreferrer" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-gray-400 hover:text-white hover:bg-primary transition-all">
            <span class="text-xs font-bold">KCK</span>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6 uppercase tracking-wider text-sm">Explorar</h4>
        <ul class="space-y-3">
          <li><a href="#inicio" class="text-gray-400 hover:text-primary text-sm transition-colors">Inicio</a></li>
          <li><a href="#videos" class="text-gray-400 hover:text-primary text-sm transition-colors">Videos</a></li>
          <li><a href="#calendario" class="text-gray-400 hover:text-primary text-sm transition-colors">Calendario</a></li>
          <li><a href="#noticias" class="text-gray-400 hover:text-primary text-sm transition-colors">Noticias</a></li>
        </ul>
      </div>

      <div>
        <h4 class="font-bold text-white mb-6 uppercase tracking-wider text-sm">Legal</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-gray-400 hover:text-primary text-sm transition-colors">Privacidad</a></li>
          <li><a href="#" class="text-gray-400 hover:text-primary text-sm transition-colors">Términos</a></li>
          <li><a href="#" class="text-gray-400 hover:text-primary text-sm transition-colors">Cookies</a></li>
          <li><a href="#" class="text-gray-400 hover:text-primary text-sm transition-colors">Contacto</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-gray-600 text-sm">
        &copy; {{year}} FormulaZeta. Todos los derechos reservados.
      </p>
      <p class="text-gray-600 text-sm flex items-center gap-1">
        Desarrollado con <i data-lucide="map-pin" class="w-3.5 h-3.5 text-primary"></i> pasión por la velocidad.
      </p>
    </div>
  </div>
</footer>
